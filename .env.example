# ─── Prospector API ─── variáveis de ambiente
# Copie este arquivo para .env e preencha os valores

# ─── Obrigatórias ───
SERPER_KEY=sua_chave_serper_aqui
OLLAMA_KEY=sua_chave_ollama_aqui

# ─── Configuração da IA ───
OLLAMA_BASE=https://ollama.com/v1
OLLAMA_MODEL=glm-5.1
OLLAMA_FALLBACKS=minimax-m2.7,deepseek-v3.2,qwen3-coder-next

# ─── Servidor ───
HOST=0.0.0.0
PORT=5000
DEBUG=false

# ─── Dados ───
DATA_DIR=/app/data

# ─── CORS ───
# Origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:8088,http://localhost:8089

# ─── Rate Limiting ───
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_SEARCH=10
RATE_LIMIT_AI=5
RATE_LIMIT_WINDOW=60

# ─── IA ───
AI_TIMEOUT=90
AI_MAX_TOKENS=2000

# ─── Circuit Breaker ───
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=30
CB_HALF_OPEN_REQUESTS=1

# ─── Discovery ───
DEFAULT_MAX_RESULTS=50
MAX_QUERY_VARIATIONS=8
SITE_FETCH_TIMEOUT=10
BRASIL_API_TIMEOUT=10
SERPER_TIMEOUT=15

# ─── Gunicorn ───
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=300